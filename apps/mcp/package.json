{
  "name": "@linearmemory/mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "migrate": "node dist/migrate.js",
    "migrate:dev": "tsx src/migrate.ts",
    "start": "node dist/index.js",
    "start:dev": "tsx src/index.ts",
    "benchmark:performance": "node scripts/benchmark-mcp.mjs",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test --test-concurrency=1 test/**/*.test.ts",
    "test:coverage": "node --import tsx --test --test-concurrency=1 --experimental-test-coverage --test-coverage-exclude=test/** --test-coverage-lines=75 --test-coverage-branches=60 --test-coverage-functions=70 test/**/*.test.ts",
    "test:integration": "node scripts/test-integration.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/node": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "5.2.1",
    "pg": "8.23.0",
    "zod": "4.5.4"
  },
  "devDependencies": {
    "@types/express": "5.0.5",
    "@types/node": "24.5.2",
    "@types/pg": "8.15.6",
    "testcontainers": "^12.0.4",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  }
}
